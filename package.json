{
  "name": "@valtown/skills",
  "version": "0.1.1",
  "description": "Val Town platform skills — guidance for building on Val Town, usable as a library and as a Claude Code plugin.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/build.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "@changesets/cli": "^2.31.0",
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/val-town/claude.git"
  },
  "homepage": "https://val.town",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
